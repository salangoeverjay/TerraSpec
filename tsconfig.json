{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "allowJs": true,
        "checkJs": false,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "target": "ES2022"
    },
    "include": ["resources/js/**/*", "components/**/*", "resources/css/**/*"],
    "exclude": ["node_modules", "vendor"]
}